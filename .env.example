# Public example configuration. Never commit the real .env file.
# ADMIN_PASSWORD must be at least 12 characters in production.
ADMIN_PASSWORD="replace-with-a-strong-admin-password"
PORT="3000"
NODE_ENV="development"

# Optional Gemini configuration retained for existing integrations.
GEMINI_API_KEY="replace-if-needed"
APP_URL="http://localhost:3000"
